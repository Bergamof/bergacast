# Copy to .env and adjust. Never commit the real .env.
BERGACAST_PUBLIC_BASE_URL=http://localhost:8080
BERGACAST_ADMIN_USERNAME=admin
BERGACAST_ADMIN_PASSWORD=change-me-please-123
# At least 32 bytes, e.g. generated with: openssl rand -base64 48
BERGACAST_JWT_SECRET=replace-with-a-long-random-secret-of-at-least-32-bytes
BERGACAST_MAX_UPLOAD_SIZE=500MB
POSTGRES_DB=bergacast
POSTGRES_USER=bergacast
POSTGRES_PASSWORD=bergacast
