# Copy to .env and adjust. Never commit the real .env.
# Public URL of the backend (API), also used by the admin SPA to reach the API.
BERGACAST_PUBLIC_BASE_URL=http://localhost:8080
# Public URL of the bucket serving the feeds, audio files and images (local S3Mock of compose.yaml).
BERGACAST_MEDIA_BASE_URL=http://localhost:9090/bergacast
# Public URL of the admin SPA, allowed to call the API (CORS).
BERGACAST_ADMIN_URL=http://localhost:8081
BERGACAST_ADMIN_USERNAME=admin
# Required on first start (at least 12 characters). Left empty on purpose.
BERGACAST_ADMIN_PASSWORD=
# Required, at least 32 bytes. Left empty on purpose: generate it with `openssl rand -base64 48`.
BERGACAST_JWT_SECRET=
BERGACAST_MAX_UPLOAD_SIZE=500MB
POSTGRES_DB=bergacast
POSTGRES_USER=bergacast
# Required by compose. Left empty on purpose.
POSTGRES_PASSWORD=
