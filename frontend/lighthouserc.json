{
	"ci": {
		"collect": {
			"numberOfRuns": 1,
			"url": [
				"http://localhost:4173/login",
				"http://localhost:4174/podcasts",
				"http://localhost:4174/podcasts/new",
				"http://localhost:4174/podcasts/mon-podcast",
				"http://localhost:4174/podcasts/mon-podcast/episodes",
				"http://localhost:4174/podcasts/mon-podcast/episodes/ep-2",
				"http://localhost:4174/podcasts/mon-podcast/tokens",
				"http://localhost:4174/admin-users"
			],
			"settings": {
				"onlyCategories": ["accessibility", "best-practices", "performance", "seo"],
				"chromeFlags": "--headless=new --no-sandbox"
			}
		},
		"assert": {
			"assertions": {
				"categories:accessibility": [
					"error",
					{ "minScore": 0.9, "aggregationMethod": "pessimistic" }
				],
				"categories:best-practices": [
					"error",
					{ "minScore": 0.9, "aggregationMethod": "pessimistic" }
				]
			}
		},
		"upload": { "target": "filesystem", "outputDir": ".lighthouseci/reports" }
	}
}
